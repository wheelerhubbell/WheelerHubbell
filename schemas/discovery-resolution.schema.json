{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whp:standing:v1.1:discovery-resolution",
  "title": "WHP Standing v1.1 discovery-resolution",
  "$defs": {
    "profile_authorization": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WHP-PROFILE-AUTHORIZATION-v1"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "canonicalization": {
              "const": "WHP-JCS-I1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "algorithm",
            "canonicalization",
            "key_id"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "profile_hash": {
              "const": "d6296b9ea7a2c570c2c0ae98af8385d6f8edee1e869fb0ae9f553c90302303a7"
            },
            "contract_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verifier_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ratified": {
              "const": true
            },
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "environment": {
              "enum": [
                "TEST",
                "LIVE"
              ]
            },
            "valid_from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "valid_until": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "profile_hash",
            "contract_hash",
            "verifier_sha256",
            "ratified",
            "issuer",
            "environment",
            "valid_from",
            "valid_until"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WHP-AUTHORITY-CERTIFICATE-v1"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "canonicalization": {
              "const": "WHP-JCS-I1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "algorithm",
            "canonicalization",
            "key_id"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "public_key": {
              "type": "string",
              "maxLength": 256,
              "description": "Canonical base64 DER SubjectPublicKeyInfo containing exactly an Ed25519 public key."
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "roles": {
              "type": "array",
              "items": {
                "enum": [
                  "SOURCE",
                  "TRANSITION",
                  "ISSUER",
                  "REGISTRY",
                  "DISCOVERY"
                ]
              },
              "minItems": 0,
              "maxItems": 64
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "minItems": 0,
              "maxItems": 64
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "minItems": 0,
              "maxItems": 64
            },
            "operations": {
              "type": "array",
              "items": {
                "enum": [
                  "INFORM",
                  "RECOMMEND",
                  "EXECUTE"
                ]
              },
              "minItems": 0,
              "maxItems": 3,
              "uniqueItems": true
            },
            "profile_hash": {
              "const": "d6296b9ea7a2c570c2c0ae98af8385d6f8edee1e869fb0ae9f553c90302303a7"
            },
            "valid_from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "valid_until": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "public_key",
            "subject",
            "roles",
            "scopes",
            "jurisdictions",
            "operations",
            "profile_hash",
            "valid_from",
            "valid_until"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WHP-KEY-REVOCATION-v1"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "canonicalization": {
              "const": "WHP-JCS-I1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "algorithm",
            "canonicalization",
            "key_id"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "key_id",
            "effective_at",
            "reason"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "trust_status": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WHP-TRUST-STATUS-v1"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "canonicalization": {
              "const": "WHP-JCS-I1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "algorithm",
            "canonicalization",
            "key_id"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "previous_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "profile_authorization_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "certificates_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "revocations_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "valid_from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "valid_until": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "sequence",
            "previous_hash",
            "profile_authorization_hash",
            "certificates_hash",
            "revocations_hash",
            "valid_from",
            "valid_until"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "trust_bundle": {
      "type": "object",
      "properties": {
        "root_public_key": {
          "type": "string",
          "maxLength": 256,
          "description": "Canonical base64 DER SubjectPublicKeyInfo containing exactly an Ed25519 public key."
        },
        "profile_authorization": {
          "$ref": "#/$defs/profile_authorization"
        },
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/certificate"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "revocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revocation"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "status_snapshot": {
          "$ref": "#/$defs/trust_status"
        }
      },
      "required": [
        "root_public_key",
        "profile_authorization",
        "certificates",
        "revocations",
        "status_snapshot"
      ],
      "additionalProperties": false
    },
    "artifact_location": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "PROFILE",
            "CONTRACT",
            "SCHEMA",
            "VERIFIER"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256",
        "url",
        "media_type"
      ],
      "additionalProperties": false
    },
    "resolution_payload": {
      "type": "object",
      "properties": {
        "version": {
          "const": "WHP-CAPABILITY-RESOLUTION-v1"
        },
        "capability_id": {
          "const": "urn:whp:standing:capability:1"
        },
        "capability_class": {
          "const": "urn:capability:machine-verifiable-standing:1"
        },
        "resolution_id": {
          "const": "urn:whp:standing:resolution:1"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment": {
          "enum": [
            "TEST",
            "LIVE"
          ]
        },
        "root_key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valid_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trust_bundle": {
          "$ref": "#/$defs/trust_bundle"
        },
        "authority_context": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "jurisdiction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "scope",
            "jurisdiction"
          ],
          "additionalProperties": false
        },
        "service_origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "service_contract": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "url",
            "sha256"
          ],
          "additionalProperties": false
        },
        "openapi": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "url",
            "sha256"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_location"
          },
          "minItems": 4,
          "maxItems": 16
        },
        "registry_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provider_discovery": {
          "type": "object",
          "properties": {
            "interface": {
              "const": "capability-catalog-v1"
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "interface",
            "url"
          ],
          "additionalProperties": false
        },
        "availability": {
          "enum": [
            "TEST_ONLY",
            "CONFIGURED_LIVE_NOT_SALE_PROVEN"
          ]
        }
      },
      "required": [
        "version",
        "capability_id",
        "capability_class",
        "resolution_id",
        "issuer",
        "environment",
        "root_key_id",
        "observed_at",
        "valid_until",
        "trust_bundle",
        "authority_context",
        "service_origin",
        "service_contract",
        "openapi",
        "artifacts",
        "registry_template",
        "provider_discovery",
        "availability"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WHP-CAPABILITY-RESOLUTION-v1"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "canonicalization": {
              "const": "WHP-JCS-I1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "algorithm",
            "canonicalization",
            "key_id"
          ],
          "additionalProperties": false
        },
        "payload": {
          "$ref": "#/$defs/resolution_payload"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/resolution",
  "x-whp-canonicalization": "WHP-JCS-I1",
  "x-whp-cross-field-constraints": "See docs/FIRST-PUBLIC-V1.md; signatures, dates, graph closure, binding, authority and issuance conditions require semantic verification."
}
